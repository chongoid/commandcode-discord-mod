[Unit]
Description=Command Code Discord Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=NODE_ENV=production
EnvironmentFile=-%h/.commandcode/mods/discord/.env
ExecStart=@NODE_BIN@ %h/.commandcode/mods/discord/dist/standalone.js
Restart=on-failure
RestartSec=10
TimeoutStopSec=20
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
NoNewPrivileges=yes

[Install]
WantedBy=default.target
