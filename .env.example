# Discord bot token (required)
DISCORD_BOT_TOKEN=your-bot-token-here

# Allowed user IDs (comma-separated) or * for all (default: *)
# DISCORD_ALLOWED_USERS=123456789,987654321

# Specific guild ID to operate in (default: all guilds)
# DISCORD_GUILD_ID=123456789

# Channel name to create (default: command-code)
# DISCORD_CHANNEL_NAME=command-code

# Delay before processing batched messages in ms (default: 600)
# DISCORD_BATCH_DELAY_MS=600

# Working directory for headless sessions (default: current directory)
# CMD_WORKING_DIR=/home/user/project

# Enable all tools in headless sessions (default: true)
# CMD_YOLO=true

# Max turns per session (default: 100)
# CMD_MAX_TURNS=100
