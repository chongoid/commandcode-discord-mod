DISCORD_BOT_TOKEN=your-bot-token-here
# Access is open by default: if neither allowlist is set, the bot replies to anyone in its servers.
# Setting users and/or roles restricts access to those (OR'd together). Roles can be IDs or names.
DISCORD_ALLOWED_USERS=123456789
# DISCORD_ALLOWED_ROLES=admin,123456789012345678
# DISCORD_ALLOW_ALL_USERS=false
# DISCORD_GUILD_ID=123456789
# DISCORD_CHANNEL_NAME=command-code
# CMD_PATH=/home/user/.local/bin/cmd
# CMD_WORKING_DIR=/home/user/project
# CMD_YOLO=false
# CMD_MAX_TURNS=100
# CMD_TIMEOUT_MS=1800000
# DISCORD_STATE_FILE=/home/user/.commandcode/discord-runtime.json
# DISCORD_LEGACY_STATE_FILE=/home/user/.commandcode/discord-threads.json
# DISCORD_LOCK_FILE=/home/user/.commandcode/discord-runtime.lock

# --- Voice transcription (optional, self-contained) --------------------------
# Run ./scripts/install-whisper.sh once to download a local whisper.cpp binary
# + GGML model (defaults below). No Hermes/Python dependency.
# WHISPER_ENABLED=true
# WHISPER_DIR=/home/user/.commandcode/whisper
# WHISPER_BINARY=/home/user/.commandcode/whisper/bin/whisper-cli
# WHISPER_MODEL=/home/user/.commandcode/whisper/models/ggml-base.bin
# WHISPER_LANGUAGE=auto
# WHISPER_TIMEOUT_MS=120000
# WHISPER_FFMPEG=ffmpeg
